{
  "id": "11a3add7-d70d-487c-ba2f-239d18f96428",
  "name": "laim KM dynamic test",
  "description": "Тест на динамику ключевой метрики",
  "fullDescription": "",
  "ui": {
    "settings": [
      {
        "page": "General",
        "title": "General",
        "components": [
          {
            "type": "form",
            "label": "Пороги теста 6.3.4",
            "config": {
              "components": [
                {
                  "parameter": "green_threshold",
                  "label": "Зелёная зона: снижение КМ не больше (в единицах delta_unit)",
                  "uiComponent": "input",
                  "type": "float",
                  "defaultValue": 0.15
                },
                {
                  "parameter": "red_threshold",
                  "label": "Красная зона: снижение КМ не меньше (в единицах delta_unit)",
                  "uiComponent": "input",
                  "type": "float",
                  "defaultValue": 0.25
                },
                {
                  "parameter": "delta_unit",
                  "label": "Единицы снижения: absolute (шкала метрики) или relative (доля от базы)",
                  "uiComponent": "input",
                  "type": "string",
                  "defaultValue": "absolute"
                },
                {
                  "parameter": "c_min",
                  "label": "Минимально допустимый уровень КМ (0 = не задан)",
                  "uiComponent": "input",
                  "type": "float",
                  "defaultValue": 0.0
                },
                {
                  "parameter": "min_valid_units",
                  "label": "Минимум оценённых единиц для вердикта",
                  "uiComponent": "input",
                  "type": "integer",
                  "defaultValue": 50
                }
              ]
            }
          }
        ]
      }
    ],
    "uiResults": {
      "semaphore": {
        "port": "all_results",
        "dataKey": "color"
      }
    },
    "result": {
      "title": "Results",
      "components": [
        {
          "label": "Результат теста",
          "type": "semaphore",
          "config": {
            "datasets": [
              {
                "value": "$.all_results.calculated_traffic_lights.test_light",
                "title": "$.all_results.calculated_traffic_lights.semaphore_title"
              }
            ]
          },
          "order": 1,
          "showOnWorkflow": true
        },
        {
          "type": "html",
          "label": "Описание теста",
          "uiComponent": "html",
          "parameter": "$.test_description",
          "config": {
            "datasets": [
              {
                "data": "$.test_description"
              }
            ]
          },
          "order": 2
        }
      ]
    }
  },
  "ports": [
